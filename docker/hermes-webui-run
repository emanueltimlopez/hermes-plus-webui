#!/command/with-contenv bash
set -euo pipefail
export HERMES_WEBUI_PORT="${PORT:-${HERMES_WEBUI_PORT:-8787}}"
export HERMES_WEBUI_HOST="${HERMES_WEBUI_HOST:-0.0.0.0}"
export HERMES_WEBUI_STATE_DIR="${HERMES_WEBUI_STATE_DIR:-/opt/data/webui}"
export HERMES_WEBUI_DEFAULT_WORKSPACE="${HERMES_WEBUI_DEFAULT_WORKSPACE:-/workspace}"
export HERMES_HOME="${HERMES_HOME:-/opt/data}"

prepare_writable_dirs() {
  mkdir -p "$HERMES_HOME" "$HERMES_WEBUI_STATE_DIR" "$HERMES_WEBUI_DEFAULT_WORKSPACE" \
    "$HERMES_HOME/cron" "$HERMES_HOME/sessions"

  if [ "$(id -u)" = "0" ]; then
    if id hermes >/dev/null 2>&1; then
      chown -R hermes:hermes "$HERMES_HOME"
    fi
    chmod -R a+rwX "$HERMES_HOME"

    if id hermeswebui >/dev/null 2>&1; then
      chown -R hermeswebui:hermeswebui "$HERMES_WEBUI_DEFAULT_WORKSPACE"
    fi
    chmod -R a+rwX "$HERMES_WEBUI_DEFAULT_WORKSPACE"
  fi
}

if ! prepare_writable_dirs; then
  fallback_home="${HERMES_FALLBACK_HOME:-/tmp/hermes}"
  echo "!! WARN: Failed to create Hermes directories under HERMES_HOME=$HERMES_HOME" >&2
  echo "!! WARN: Falling back to ephemeral storage at $fallback_home" >&2
  export HERMES_HOME="$fallback_home"
  export HERMES_WEBUI_STATE_DIR="$fallback_home/webui"
  export HERMES_WEBUI_DEFAULT_WORKSPACE="${HERMES_FALLBACK_WORKSPACE:-/tmp/hermes-workspace}"
  prepare_writable_dirs
fi

exec /hermeswebui_init.bash
