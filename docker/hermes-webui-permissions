#!/usr/bin/env bash
set -euo pipefail

HERMES_HOME="${HERMES_HOME:-/opt/data}"
HERMES_WEBUI_STATE_DIR="${HERMES_WEBUI_STATE_DIR:-$HERMES_HOME/webui}"
HERMES_WEBUI_DEFAULT_WORKSPACE="${HERMES_WEBUI_DEFAULT_WORKSPACE:-/workspace}"
HERMES_WORKSPACE_DIR="${HERMES_WORKSPACE_DIR:-$HERMES_HOME/workspace}"
CHOWN=/usr/bin/chown.real
CHMOD=/usr/bin/chmod.real

try_chown() {
  "$CHOWN" "$@" 2>/dev/null || true
}

try_chmod() {
  "$CHMOD" "$@" 2>/dev/null || true
}

mkdir -p "$HERMES_HOME" "$HERMES_WEBUI_STATE_DIR" "$HERMES_WORKSPACE_DIR" \
  "$HERMES_HOME/cron" "$HERMES_HOME/sessions"
if [ ! -e "$HERMES_WEBUI_DEFAULT_WORKSPACE" ]; then
  ln -s "$HERMES_WORKSPACE_DIR" "$HERMES_WEBUI_DEFAULT_WORKSPACE"
fi
if [ ! -s "$HERMES_HOME/active_profile" ]; then
  printf 'default\n' > "$HERMES_HOME/active_profile"
fi

if id hermes >/dev/null 2>&1; then
  try_chown -R hermes:hermes "$HERMES_HOME"
fi
try_chmod -R a+rwX "$HERMES_HOME"
try_chmod a+rw "$HERMES_HOME/active_profile"
if [ -e "$HERMES_HOME/state.db" ]; then
  try_chmod a+rw "$HERMES_HOME/state.db"
fi
try_chmod -R a+rwX "$HERMES_WEBUI_STATE_DIR"
try_chmod 1777 "$HERMES_WEBUI_STATE_DIR"

if id hermeswebui >/dev/null 2>&1; then
  try_chown -R hermeswebui:hermeswebui "$HERMES_WEBUI_STATE_DIR"
  try_chown -R hermeswebui:hermeswebui "$HERMES_WORKSPACE_DIR"
fi
try_chmod -R a+rwX "$HERMES_WEBUI_STATE_DIR"
try_chmod 1777 "$HERMES_WEBUI_STATE_DIR"
try_chmod -R a+rwX "$HERMES_WORKSPACE_DIR"
try_chmod 1777 "$HERMES_WORKSPACE_DIR"
